# 环境变量模板：复制为仓库根目录的 .env 使用（Vite 相关项也可写入 .env.development）
# 数据库配置
DB_HOST=localhost
DB_USER=data
DB_PASSWORD=your_database_password_here
DB_NAME=data
# DB_POOL_CONNECTION_LIMIT=20
# DB_POOL_QUEUE_LIMIT=20

# Redis（utils/redisClient.js）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=2
# REDIS_PASSWORD=
# 云 Redis 启用 TLS 时设为 true
# REDIS_TLS=false
# REDIS_TLS_REJECT_UNAUTHORIZED=true
# 按 pattern 批量删缓存时 SCAN 的 COUNT hint（50~1000，默认 200）；生产勿用 KEYS
# REDIS_SCAN_COUNT=200
# 列表/详情缓存兜底 TTL（秒，默认 604800=7 天）；管理端变更时仍会主动 del
# REDIS_LIST_CACHE_TTL_SEC=604800
# REDIS_DETAIL_CACHE_TTL_SEC=604800
# Redis 性能统计日志间隔（毫秒，默认 300000；设为 0 关闭定时输出）
# REDIS_METRICS_LOG_INTERVAL_MS=300000
# 淘汰策略：列表类缓存用 setEx 设 TTL；详情/单键在业务写入时 del；Redis 服务端 maxmemory-policy 请在实例上单独配置（如 allkeys-lru）

# 浏览器跨域：在代码默认白名单之外追加允许的 Origin（逗号分隔，勿加引号）
# 例：CORS_ORIGINS=https://admin.example.com,https://staging.example.com
# CORS_ORIGINS=
# 是否允许 *.2000gallery.art 子域通配（生产若需收紧可设为 false）
# CORS_ALLOW_SUBDOMAIN_WILDCARD=true

# Wespace 代理：生产环境校验 query/body 中的 usn 与当前用户 external_users 绑定一致
# ENFORCE_WESPACE_USN_BINDING=true

# JWT配置
JWT_SECRET=your_very_strong_jwt_secret_key_here_at_least_32_characters

# 后台公开注册（POST /api/auth/register）：默认关闭；仅本地/测试可设为 true
# ALLOW_PUBLIC_ADMIN_REGISTER=false
# AUTH_REGISTER_RATE_LIMIT_PER_HOUR=3

# 集成回调共享密钥（POST /api/asset-transfer/callback，请求头 X-Webhook-Secret 或 query secret）
# ASSET_TRANSFER_WEBHOOK_SECRET=change_me_to_a_long_random_string

# 小程序敏感接口限流
# WX_GET_PHONE_NUMBER_RATE_LIMIT=10
# WX_IDCARD_VERIFY_RATE_LIMIT_PER_HOUR=20
# WX_LOGIN_RATE_LIMIT_PER_15MIN=30
# WX_REFRESH_RATE_LIMIT_PER_15MIN=60
# WX_PUBLIC_AUX_RATE_LIMIT_PER_MIN=60

# 微信小程序登录 token（access 默认 2h；refresh 默认 30 天）
# 部署前需执行 scripts/sql/create-wx-refresh-tokens.sql（含 wx_user_sessions、wx_refresh_tokens）
WX_ACCESS_TOKEN_EXPIRES_IN=2h
WX_REFRESH_TOKEN_TTL_DAYS=30

# 艺术推荐官体系（Phase 1）
# 推荐关系有效期（天）；VIP 升级累计消费门槛（元）
# REFERRAL_BINDING_DAYS=365
# VIP_SPEND_THRESHOLD_YUAN=5000

# 艺术推荐官体系（Phase 2）佣金与结算
# COMMISSION_CAP_YUAN=5000
# VIP_COMMISSION_BONUS_RATE=0.02
# COMMISSION_SETTLEMENT_SCHEDULER=true
# COMMISSION_SETTLEMENT_POLL_MS=300000

# 艺术推荐官体系（Phase 3）提现、首单奖励、优惠券
# 与微信商家转账额度保持一致：单笔 200、单用户日 2000、商户日 50000
# MIN_WITHDRAW_YUAN=0
# MAX_WITHDRAW_YUAN=200
# USER_DAILY_WITHDRAW_LIMIT_YUAN=2000
# MERCHANT_DAILY_WITHDRAW_LIMIT_YUAN=50000
# 兼容旧变量名（等同 USER_DAILY_WITHDRAW_LIMIT_YUAN）
# DAILY_WITHDRAW_LIMIT_YUAN=2000
# FIRST_REFERRAL_BONUS_YUAN=30
# NEW_USER_COUPON_YUAN=50
# NEW_USER_COUPON_MIN_ORDER_YUAN=0
# NEW_USER_COUPON_VALID_DAYS=30
# ART_ADVISOR_MIN_RATE=0.15
# ART_ADVISOR_MAX_RATE=0.25
# WX_WITHDRAW_AUTO_TRANSFER=false
# 开启自动转账后，设为 true 则用户申请后需商家后台审核，审核通过才发起微信转账并让用户确认收款
# WX_WITHDRAW_REQUIRE_ADMIN_APPROVAL=false
# WX_TRANSFER_SCENE_ID=1000
# WX_WITHDRAW_NOTIFY_URL=

# 艺术推荐官体系（Phase 5）分享统计与对账
# REFERRAL_RECONCILIATION_SCHEDULER=true
# REFERRAL_RECONCILIATION_INTERVAL_MS=86400000

# 微信小程序配置
WX_APPID=wx96a502c78c9156d0
WX_SECRET=your_wechat_secret_here

# 腾讯地图（地理编码代理 GET /api/wx/map/geocode?address=...，无需登录；未缓存按 IP 限流，命中缓存不限流）
TENCENT_MAP_KEY=your_tencent_map_key_here
# MAP_GEOCODE_RATE_LIMIT_PER_MIN=30
# MAP_GEOCODE_CACHE_TTL_SEC=2592000

# 商家列表/详情 Redis 缓存 TTL（秒，默认 1800 / 3600）
# MERCHANT_LIST_CACHE_TTL_SEC=1800
# MERCHANT_DETAIL_CACHE_TTL_SEC=3600

# 微信小程序发货信息录入 uploadShippingInfo（顺丰发货成功后自动调用；也可 POST /api/wx/logistics/upload-shipping-info 手动补录）
# 微信小程序合单发货信息录入 uploadCombinedShippingInfo（POST /api/wx/logistics/upload-combined-shipping-info）
# 微信小程序查询订单发货状态 getOrder（POST /api/wx/logistics/wechat-order/get）
# 微信小程序查询订单列表 getOrderList（POST /api/wx/logistics/wechat-order/list）
# 微信小程序确认收货提醒 notifyConfirmReceive（POST /api/wx/logistics/wechat-order/notify-confirm-receive）
# 微信小程序消息跳转路径 setMsgJumpPath（POST /api/wx/logistics/wechat-order/set-msg-jump-path）
# 微信小程序交易结算管理确认查询 isTradeManagementConfirmationCompleted（POST /api/wx/logistics/wechat-order/is-trade-management-completed）
# WX_MSG_JUMP_PATH=pages/orders/detail
# WX_UPLOAD_SHIPPING_INFO_ENABLED=true
# 顺丰轨迹出现「已签收」时自动调用 notifyConfirmReceive（每单仅一次，Redis 去重）
# 微信小程序确认收货组件：买家详情返回 wechat_confirm_receipt.extra_data；回调 success 后 POST /api/wx/pay/orders/confirm-receipt/verify
# WX_AUTO_NOTIFY_CONFIRM_RECEIVE_ENABLED=true

# 订阅消息下发默认参数（可选）
# WX_SUBSCRIBE_MINIPROGRAM_STATE=formal
# WX_SUBSCRIBE_LANG=zh_CN
# WX_SUBSCRIBE_ENABLED=true
# WX_SUBSCRIBE_SEND_PAYMENT_PENDING=true
# WX_SUBSCRIBE_PAYMENT_DEADLINE_MINUTES=30
# WX_SUBSCRIBE_PAYMENT_PENDING_REMIND_BEFORE_MINUTES=5
# WX_SUBSCRIBE_PAYMENT_PENDING_POLL_MS=30000
# WX_SUBSCRIBE_PAYMENT_PENDING_SCHEDULER=true
# WX_SUBSCRIBE_PAID_NOTIFY_RETRY_MS=8000
# WX_SUBSCRIBE_ORDER_PAGE=pages/orders/detail
# 私有模板 priTmplId（不配置则使用下列默认值）
# WX_SUBSCRIBE_TMPL_ORDER_CANCELLED=eRo3ZqegpqBpvm03bYz69SEUxw5s28xYsUG0_2F2QFo
# WX_SUBSCRIBE_TMPL_REFUND_RESULT=TqINQeQTovq4TeOt8n93KaOH7ZzaDApsrvhV-20XLYs
# WX_SUBSCRIBE_TMPL_PAYMENT_PENDING=3XayJ63OyXUiOXC2XQXw2WXD_fjx1PLuMPD28HjJvBY
# WX_SUBSCRIBE_TMPL_VIRTUAL_DELIVERY=inIqNTjUpx2vNBgGvBg4TAuHeC9m9nJL16WyxkqcB5o
# WX_SUBSCRIBE_TMPL_LOGISTICS_STATUS=cas1lppyqjEsP-vpsMrR6pQo2I7iaqnEERMi19DuF5o
# WX_SUBSCRIBE_TMPL_ORDER_SHIPPED=cas1lppyqjEsP-vpsMrR6pQo2I7iaqnEERMi19DuF5o
# WX_SUBSCRIBE_TMPL_ORDER_PAID=cFih0vORYpwPHBZpAXKgKhM_9OHfD3xHAuHeJv0NZSs
# 顺丰开放平台统一接入（HTTPS POST，Content-Type: application/x-www-form-urlencoded）
# 沙箱：https://sfapi-sbox.sf-express.com/std/service
# 正式：https://bspgw.sf-express.com/std/service
# 必传：partnerID、requestID（UUID）、serviceCode、timestamp（毫秒）、msgData（JSON 字符串）
# 鉴权（三选一，推荐沙箱联调先用 OAuth2）：
# 1) MD5：SF_CHECK_WORD=应用详情里的「沙箱校验码」或「生产校验码」（须与 SF_API_BASE_URL 环境一致）
# 2) OAuth2 自动取 token：SF_USE_OAUTH=true，SF_OAUTH_SECRET=同上校验码（可与 SF_CHECK_WORD 相同）
# 3) OAuth2 手动 token：SF_ACCESS_TOKEN=（约 2 小时有效）
# SF_PARTNER_ID=
# SF_CHECK_WORD=
# SF_USE_OAUTH=true
# SF_OAUTH_SECRET=
# SF_ACCESS_TOKEN=
# SF_API_BASE_URL=https://sfapi-sbox.sf-express.com/std/service
# SF_MONTHLY_CARD=
# 沙箱联调测试月结卡号（非正式）：7551234567
# SF_DEFAULT_EXPRESS_TYPE_ID=1
# 结算预览/下单默认包裹重量（kg）
# SF_DEFAULT_PACKAGE_WEIGHT_KG=1
# 原作仅有长宽时用于估算体积的默认厚度（cm）
# SF_DEFAULT_ARTWORK_THICKNESS_CM=5
# 发件仓库地址（结算预览计算运费时使用）
# SF_SENDER_PROVINCE=广东省
# SF_SENDER_CITY=深圳市
# SF_SENDER_DISTRICT=南山区
# SF_SENDER_ADDRESS=xx仓库详细地址
# 顺丰询价失败时的兜底运费（元）；不配置且询价失败则结算预览报错
# SF_CHECKOUT_FALLBACK_SHIPPING_YUAN=12
# 结算报价 token 有效期（秒，默认 900）
# CHECKOUT_QUOTE_TTL_SEC=900
# SF_EXPRESS_TYPES=[{"service_type":1,"service_name":"顺丰特快"},{"service_type":2,"service_name":"顺丰标快"}]
# 留空则发货页默认展示：特快/标快/即日/陆运包裹/电商标快/卡航/半日达/填舱标快/特快包裹
# 路由/产品附录：https://open.sf-express.com/developSupport/734349?activeIndex=589678
# 快件产品类别：https://open.sf-express.com/developSupport/734349?activeIndex=324604
# SF_ROUTE_OPCODE_EXTRA=[{"opCode":"9999","reasonCode":"","name":"定制节点","firstStatusCode":2,"firstStatusName":"运送中","actionType":200001}]
# 顺丰业务错误码扩展（JSON 数组，与内置表合并；字段 code / nameZh / nameEn / suggestion）
# SF_ERROR_CODE_EXTRA=[{"code":"99999","nameZh":"自定义错误","suggestion":"联系顺丰客服"}]
# 顺丰 API 平台公共返回码扩展（apiResultCode，如 A1006；字段 code / nameZh / suggestion）
# SF_API_RESULT_CODE_EXTRA=[{"code":"A1999","nameZh":"自定义平台错误","suggestion":"联系顺丰客服"}]
#
# 云打印 HTML 面单（COM_RECE_CLOUD_PRINT_HTML）
# 模板编码须在顺丰开放平台「云打印接口」详情页获取，且须与 SF_PARTNER_ID 对应（后缀为顾客编码）
# 错误示例：fm_76130_international_PDD 属于其他客户/渠道，不能用于你的 partnerID
# 二选一即可（不要同时写完整编码又保留 {partnerId}，否则会拼成 xxx_PID_PID）：
# SF_CLOUD_PRINT_TEMPLATE_CODE=fm_76130_standard_{partnerId}
# SF_CLOUD_PRINT_TEMPLATE_CODE=fm_76130_standard_QNSJWL4QG62S
# 仅在使用模板编辑器且已发布自定义区时填写（须含 _custom_，不能填标准模板编码）：
# SF_CLOUD_PRINT_CUSTOM_TEMPLATE_CODE=fm_76130_standard_custom_10000022213_1
# 第三方 ERP 对接时建议配置运单号校验（1=收方电话后6位，2=寄方电话后6位）
# SF_CLOUD_PRINT_WAYBILL_CHECK_TYPE=1
# SF_CLOUD_PRINT_WAYBILL_CHECK_VALUE=
# SF_CLOUD_PRINT_EXT_JSON={"channel":"medicine"}
# 物流轨迹变更推送（getPath / 定时轮询）
# WX_LOGISTICS_PATH_NOTIFY_ENABLED=true
# WX_LOGISTICS_PATH_NOTIFY_SCHEDULER=true
# WX_LOGISTICS_PATH_POLL_MS=300000
# WX_LOGISTICS_PATH_POLL_BATCH=20
# WX_LOGISTICS_PATH_LAST_TTL_SEC=3888000
# WX_LOGISTICS_PATH_NOTIFY_GAP_MS=300
# 数字艺术品虚拟发货服务卡片（notify_type 2003，notify_code=微信支付订单号）
# WX_VIRTUAL_DELIVERY_ENABLED=true
# WX_VIRTUAL_DELIVERY_NOTIFY_TYPE=2003
# WX_VIRTUAL_DELIVERY_NOTIFY_RETRY_MS=65000
# WX_VIRTUAL_DELIVERY_DEFAULT_PRODUCT_IMG=https://wx.oss.2000gallery.art/default-product.png
# 微信物流助手（已弃用，改顺丰官方 API；保留占位兼容旧部署）
# WX_LOGISTICS_DEFAULT_BIZ_ID=
# WX_LOGISTICS_DEFAULT_WXA_PATH=/pages/orders/detail?id={order_id}

# 阿里云OSS配置
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=your_oss_bucket_name
OSS_REGION=your_oss_region

# 阿里云OCR服务配置（用于身份证识别）
ALIBABA_CLOUD_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_aliyun_access_key_secret

# 微信支付配置
WX_PAY_MCH_ID=1360639602
WX_PAY_KEY=your_wx_pay_key_here
WX_PAY_SERIAL_NO=34DF8EA1B52AD35997FF23DFAD7940574A1D6857
WX_PUB_ID=PUB_KEY_ID_0113606396022025041900441636000800
# 平台公钥路径（默认 ssl/pub_key.pem）；轮换时可追加 ssl/platform-certs/{serial}.pem 或 JSON：
# WX_PAY_PLATFORM_PUB_KEY_PATH=ssl/pub_key.pem
# WX_PAY_PLATFORM_CERTS=[{"serial":"PUB_KEY_ID_xxx","pemPath":"ssl/platform-certs/PUB_KEY_ID_xxx.pem"}]

# 阿里云身份证识别配置
ALIYUN_IDCARD_AUTHCODE=your_aliyun_authcode_here

# 对外 API 与 OSS 浏览器域名（后端：config/publicEnv.js；可不配则按 NODE_ENV 使用代码内默认）
# PUBLIC_API_BASE_URL=https://api.wx.2000gallery.art:2000
# OSS_PUBLIC_ORIGIN=https://wx.oss.2000gallery.art

# 前端 Vite（见 src/config.js；生产构建写入 .env.production）
# 独立 API 域名（需 CDN 回源 Node:2000 且允许 OPTIONS，见 deploy/CDN-API-CORS.md）：
# VITE_PUBLIC_API_BASE_URL=https://api.wx.2000gallery.art
# 备选：管理台同源反代 /api 时用 same-origin（见 deploy/nginx-admin.example.conf）
# VITE_PUBLIC_API_BASE_URL=same-origin
# VITE_OSS_PUBLIC_ORIGIN=https://wx.oss.2000gallery.art
# 列表缩略图（阿里 OSS x-oss-process / 七牛 imageView2）
# VITE_LIST_IMAGE_WIDTH=240
# VITE_LIST_IMAGE_QUALITY=80
# VITE_QINIU_CDN_ORIGINS=http://qn.2000gallery.art,https://qn.2000gallery.art

# WMS 仓库图（采用仓库图 / 管理端预览，见 config/wmsHttp.js）
# QINIU_ACCESS_KEY= / QINIU_SECRET_KEY= — 配置后采用仓库图时拉七牛原图
# WMS_IMAGE_VIEW_PARAMS= — 留空=原图；或 imageView2/2/w/0/interlace/1/q/100
# WMS_IMAGE_PREVIEW_VIEW_PARAMS=imageView2/2/w/640/interlace/1/q/90
# WMS_APPLY_WEBP_QUALITY=92 — 采用仓库图转 WebP 起始质量（70–100）
# VITE_DEV_PROXY_TARGET=https://api.wx.2000gallery.art:2000

# 服务器配置
PORT=2000
# 数字藏品领取说明：设为 true 时小程序端强制隐藏所有领取文案（审核/应急用；后台仍可编辑文案）
# DIGITAL_CLAIM_COPY_FORCE_HIDDEN=false
# 勿在 .env 中设置 NODE_ENV（Vite 构建会告警）；前端生产构建由 `vite build` 自动处理，Node 服务用启动命令或进程管理器设置
# NODE_ENV=production

# 安全配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX_REQUESTS=5

# 验证码 / Wespace 用户 API（Basic 认证，勿写入源码）
VERIFICATION_CODE_AUTHORIZATION=Basic <base64(user:secret)>

# Wespace 订单 / 商品 API（Bearer JWT，勿写入源码）
EXTERNAL_BEARER_TOKEN=