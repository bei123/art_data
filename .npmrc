# Route @bei123/* packages to GitHub Packages (npmjs.org for everything else).
# Auth: set NODE_AUTH_TOKEN to a classic PAT with read:packages (local),
# or let GitHub Actions inject secrets.GITHUB_TOKEN.
# Docs: https://docs.github.com/packages/working-with-a-github-packages-registry/working-with-the-npm-registry
@bei123:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
